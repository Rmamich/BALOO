%% Working on kronu 

n = 9;
m = 3;
n_nodes = 1;

B = 1:(n*n);

B = reshape(B, n, n);

A = zeros(n, n, 3);
A(:, :, 1) = B;
A(:, :, 2) = B*2;
A(:, :, 3) = B*3;





