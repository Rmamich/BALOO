%% Finite Difference for azEl Hessians
%Finite Difference second derivative
function deriv2 = FD2_azEl(x,h, RCF_N)
%assumes fun output is scalar or vector valued
%find dimensions
n = length(x);
[funEvalC, ~] = relNavPinHoleOpticalMeas_target(x, RCF_N);
N = length(funEvalC);

deriv2 = zeros(n,n, N);

for kk = 1:N
    for ii = 1:n
        dx1 = zeros(n,1);
        dx1(ii) = h;
        for jj = 1:n
            dx2 = zeros(n,1);
            dx2(jj) = h;
            [funEvalFF, ~] = relNavPinHoleOpticalMeas_target(x + dx1 + dx2, RCF_N);
            [funEvalFB, ~] = relNavPinHoleOpticalMeas_target(x + dx1 - dx2, RCF_N);
            [funEvalBF, ~] = relNavPinHoleOpticalMeas_target(x - dx1 + dx2, RCF_N);
            [funEvalBB, ~] = relNavPinHoleOpticalMeas_target(x - dx1 - dx2, RCF_N);
            
            
            deriv2(jj,ii, kk) = (funEvalFF(kk) - funEvalFB(kk) - funEvalBF(kk) + funEvalBB(kk))/(4*h^2);
        end
    end
end
end




function deriv2 = FHess2_tbp_j2(x,h, gravParam, betas, Rbody_N, RN_rot)
%assumes fun output is scalar or vector valued
%find dimensions
n = length(x);
[funEvalC] = tbpJ2_accelerometerGating_rpod_lidarBias_GSKF( [0, 1], [x;x], gravParam, betas, [0; 0; 0], [9, 9], 1e-3, Rbody_N, RN_rot, [0; 0; 0], 0, 0);
N = length(funEvalC);

deriv2 = zeros(n,n, N);

for kk = 1:N
    for ii = 1:n
        dx1 = zeros(n,1);
        dx1(ii) = h;
        for jj = 1:n
            dx2 = zeros(n,1);
            dx2(jj) = h;
            [funEvalFF] = tbpJ2_accelerometerGating_rpod_lidarBias_GSKF( [0, 1], [x + dx1 + dx2; x + dx1 + dx2], gravParam, betas, [0; 0; 0], [9, 9], 1e-3, Rbody_N, RN_rot, [0; 0; 0], 0, 0);
            [funEvalFB] = tbpJ2_accelerometerGating_rpod_lidarBias_GSKF( [0, 1], [x + dx1 - dx2; x + dx1 - dx2], gravParam, betas, [0; 0; 0], [9, 9], 1e-3, Rbody_N, RN_rot, [0; 0; 0], 0, 0);
            [funEvalBF] = tbpJ2_accelerometerGating_rpod_lidarBias_GSKF( [0, 1], [x - dx1 + dx2; x - dx1 + dx2], gravParam, betas, [0; 0; 0], [9, 9], 1e-3, Rbody_N, RN_rot, [0; 0; 0], 0, 0);
            [funEvalBB] = tbpJ2_accelerometerGating_rpod_lidarBias_GSKF( [0, 1], [x - dx1 - dx2; x - dx1 - dx2], gravParam, betas, [0; 0; 0], [9, 9], 1e-3, Rbody_N, RN_rot, [0; 0; 0], 0, 0);
            
            
            deriv2(jj,ii, kk) = (funEvalFF(kk) - funEvalFB(kk) - funEvalBF(kk) + funEvalBB(kk))/(4*h^2);
        end
    end
end
end


function [A,z]=A_CRTBP_CSJ(tnonDim,x_nonDimR, gravParam, beta_nonDim, gate_nonDim)
% Complex step Jacobian
z=CRTBP_targetChaser( tnonDim, x_nonDimR, gravParam, beta_nonDim, zeros(3, 1), [9, 9], gate_nonDim, eye(3), eye(3), zeros(3, 1), 0, 0);                     % function value
n=numel(x_nonDimR);                     % size of independent
m=numel(z);                     % size of dependent
A=zeros(m,n);                   % allocate memory for the Jacobian matrix
h=n*eps;                        % differentiation step size
for k=1:n                       % loop for each independent variable 
    x1=x_nonDimR;                       % reference point
    x1(k)=x1(k)+h*1i;            % increment in kth independent variable
    A(:,k)=imag(CRTBP_targetChaser( tnonDim, x1, gravParam, beta_nonDim, zeros(3, 1), [9, 9], gate_nonDim, eye(3), eye(3), zeros(3, 1), 0, 0))/h;     % complex step differentiation 
end
end



function [A,z_nonDim]=A_CRTBP_CSJ_dimInertial(tnonDim,x_Dim, gravParam, beta_nonDim, gate_nonDim)
% Complex step Jacobian
L = gravParam(2); % m
n = gravParam(3); % 1/s
tCharacteristic = gravParam(4); % s
timeDim = tnonDim*tCharacteristic; % s
x_nonDimR = nonDimRotational_dimInertial_conversion(x_Dim, timeDim, L, n, tCharacteristic, 'fullState_dimN2nondimR');
z_nonDim=CRTBP_targetChaser( tnonDim, x_nonDimR, gravParam, beta_nonDim, zeros(3, 1), [9, 9], gate_nonDim, eye(3), eye(3), zeros(3, 1), 0, 0);                     % function value
% z_Dim = nonDimRotational_dimInertial_conversion(z_nonDim, timeDim, L, n, tCharacteristic, 'fullStateDot_nondimR2dimN');
n=numel(x_nonDimR);                     % size of independent
m=numel(z_nonDim);                     % size of dependent
A=zeros(m,n);                   % allocate memory for the Jacobian matrix
h=n*eps;                        % differentiation step size
for k=1:n                       % loop for each independent variable 
    x1_Dim=x_Dim;                       % reference point
    x1_Dim(k)=x1_Dim(k)+h*1i;            % increment in kth independent variable
    x1_nonDim = nonDimRotational_dimInertial_conversion(x1_Dim, timeDim, L, n, tCharacteristic, 'fullState_dimN2nondimR');
    zp_nonDim = CRTBP_targetChaser( tnonDim, x1_nonDim, gravParam, beta_nonDim, zeros(3, 1), [9, 9], gate_nonDim, eye(3), eye(3), zeros(3, 1), 0, 0);
    zp_Dim = nonDimRotational_dimInertial_conversion([zp_nonDim; x1_Dim([1:3, 10:12])], timeDim, L, n, tCharacteristic, 'fullStateDot_nondimR2dimN');
    A(:,k)=imag(zp_Dim)/h;     % complex step differentiation 
end
end




function [A,z]=H_azEl_CSJ(x_nonDimR, RCF_N)
% Complex step Jacobian
z=pinHoleOpticalMeas_target(x_nonDimR, RCF_N);                     % function value
n=numel(x_nonDimR);                     % size of independent
m=numel(z);                     % size of dependent
A=zeros(m,n);                   % allocate memory for the Jacobian matrix
h=n*eps;                        % differentiation step size
for k=1:n                       % loop for each independent variable 
    x1=x_nonDimR;                       % reference point
    x1(k)=x1(k)+h*1i;            % increment in kth independent variable
    A(:,k)=imag(pinHoleOpticalMeas_target(x1, RCF_N))/h;     % complex step differentiation 
end
end
