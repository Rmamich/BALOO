%% Test A for CRTBP
clear all
close all

dx = [1 1 1, .01 .01 .01, .0001 .0001 .0001, 1 1 1, .01 .01 .01, .0001 .0001 .0001]';


mu = 0.012150584270; % mass ratio from paper
L = 384400; % km -- characteristic length 

load(fullfile('./MAT/NRHOVentingScenario_nonDim/', 'truth_forwardBackward.mat'));
load(fullfile('./MAT/NRHO_Venting_RelNav_nonDim/InitCovFactor/none/EKF', 'aci2body2CF1.mat'));
PNondim = 1.511143593137; % period non dimensional from paper
tCharacteristic = 3.751902619517e5; % s -- characteristic time from paper  

tDim = PNondim*tCharacteristic; % dimensional period -- convert as nondimensional period * characteristic time 
P = tDim; %
n = 2*pi/P; % 1/s 
% 0.001 rad/ n 
 

tDim_prop = 8000; % my desired propagation time for MILTON
tNondim = tDim_prop/tCharacteristic; % convert to nondimensional 

idx = 1;

timeDim = idx-1;
timenonDim = timeDim/tCharacteristic;

xt = truthState_N_new(1:9, 200);
xc = truthState_N_new(10:18, 200);

xt(7:9) = 0.001;
xc(7:9) = xt(7:9);

x = [xt; xc];
eomTruth = @CRTBP_targetChaser;
gravParam= [mu, L, n, tCharacteristic]; 
beta = ones(3, 1)*1e-5; % 1/s
% beta = [0, 1/3600, 0];
beta_nonDim = beta*tCharacteristic; % nondim  % 1/s *s
gate = 1e-7; % m/s/s
gate_nonDim = gate/L/n/n; % [-]
dt = 1;





nx = length(x);


%% Checking A in rotational nondim wrt rortational nondim
% Test Passed :)
x_nonDimR = nonDimRotational_dimInertial_conversion(x, timeDim, L, n, tCharacteristic, 'fullState_dimN2nondimR');
[ xDotNom_nonDimR ] = eomTruth( timenonDim, x_nonDimR, gravParam, beta_nonDim, zeros(3, 1), [9, 9], gate_nonDim, eye(3), eye(3), zeros(3, 1), 0, 0);

xt_nonDim = x_nonDimR(1:9);
xc_nonDim = x_nonDimR(10:18);


% CRTBP
% Chaser
Ac = zeros(9);
Ac(1:3, 4:6) = eye(3);
[dadr] = gravJac_CRTBP(xc_nonDim(1:3), gravParam);
Ac(4:6, 1:3) = dadr;
Ac(4:6, 4:6) = [0, 2, 0; -2, 0, 0; 0, 0, 0];

Ac(7:9, 7:9) = -eye(3)*beta_nonDim(2);


% dX_nonDimR_dX_dimN_c = dX_nonDimRot_dX_dimN(xc_nonDim, t, gravParam);
% Ac = dX_nonDimR_dX_dimN_c*Ac*dX_nonDimR_dX_dimN_c';
% Target
At = zeros(9);
At(1:3, 4:6) = eye(3);
[dadr] = gravJac_CRTBP(xt_nonDim(1:3), gravParam);
At(4:6, 1:3) = dadr;
At(4:6, 4:6) = [0, 2, 0; -2, 0, 0; 0, 0, 0];

At(4:6, 7:9) = eye(3);
At(7:9, 7:9) = -eye(3)*beta_nonDim(1); % Assumes constant burn


% Transform A by doing:
% dX_dimN/dX_nonDimRot * A_nonDimRot * dX_dimN/dX_nonDimRot'
% dX_nonDimR_dX_dimN_t = dX_nonDimRot_dX_dimN(xt, t, gravParam);
% At = dX_nonDimR_dX_dimN_t*At*dX_nonDimR_dX_dimN_t';

% [~, Aanalitical] = buildPhi(x_nonDimR, gravParam, dt, beta_nonDim, [9, 9], false, true, timenonDim);

Aanalitical = [At, zeros(9); zeros(9), Ac];


[Anumerical,z]=A_CRTBP_CSJ(timenonDim,x_nonDimR, gravParam, beta_nonDim, gate_nonDim);
diffA = Anumerical - Aanalitical;


% for jx = 1:(nx/3)
%     fprintf('rows: %d, %d, %d\n', (jx*3-2):jx*3)
%     for ix = 1:(nx/3)
%         fprintf('\t%0.5e, %0.5e, %0.5e\n\t%0.5e, %0.5e, %0.5e\n\t%0.5e, %0.5e, %0.5e\n\n', diffA((jx*3-2):jx*3, (ix*3-2):ix*3))
%     end
% end
% 
% 
% fprintf('\n\n\n\n\n\n\n\n\n\n\n\n\n\n')


%% Check jacobian of rotational, nondim wrt inertial and dimensional
% Test Passed :)
dx_nonDim = [ones(3, 1)/L; ones(3, 1)*.01/L/n; ones(3, 1)*.0001/(1000*L)*tCharacteristic^2; ones(3, 1)/L; ones(3, 1)*.01/L/n; ones(3, 1)*.0001/(1000*L)*tCharacteristic^2]/1000000;


dX_dimN_dX_nonDimR = dX_dimN_dX_nonDimRot(x_nonDimR, timeDim, gravParam);


Aanalitical = dX_dimN_dX_nonDimR;


inputFlag = 'R2N'; % inertial to rotational 
[ xNom_N] = nonDimRotational_dimInertial_conversion(x_nonDimR, timeDim, L, n, tCharacteristic, inputFlag);

Anumerical = 0*Aanalitical;
for ix=1:9
    xp_nonDim = x_nonDimR(1:9);
    xp_nonDim(ix) = xp_nonDim(ix)+dx_nonDim(ix);
    [ xp_nonDimR ] = nonDimRotational_dimInertial_conversion(xp_nonDim, timeDim, L, n, tCharacteristic, inputFlag);
    Anumerical(:,ix) = (xp_nonDimR-xNom_nonDimR)/dx(ix);
end





diffA = Anumerical - Aanalitical;


% for jx = 1:(9/3)
%     fprintf('rows: %d, %d, %d\n', (jx*3-2):jx*3)
%     for ix = 1:(9/3)
%         fprintf('\t%0.5e, %0.5e, %0.5e\n\t%0.5e, %0.5e, %0.5e\n\t%0.5e, %0.5e, %0.5e\n\n', diffA((jx*3-2):jx*3, (ix*3-2):ix*3))
%     end
% end








%% Check jacobian of rotational, nondim wrt inertial and dimensional
% Test Passed :)
[dX_nonDimR_dX_dimN] = dX_nonDimRot_dX_dimN(x(1:9), timeDim, gravParam);


Aanalitical = dX_nonDimR_dX_dimN;


inputFlag = 'N2R'; % inertial to rotational 
[ xNom_nonDimR ] = nonDimRotational_dimInertial_conversion(x(1:9), timeDim, L, n, tCharacteristic, inputFlag);

Anumerical = 0*Aanalitical;
for ix=1:9
    xp_Dim = x(1:9);
    xp_Dim(ix) = xp_Dim(ix)+dx(ix);
    [ xp_nonDimR ] = nonDimRotational_dimInertial_conversion(xp_Dim, timeDim, L, n, tCharacteristic, inputFlag);
    Anumerical(:,ix) = (xp_nonDimR-xNom_nonDimR)/dx(ix);
end





diffA = Anumerical - Aanalitical;


% for jx = 1:(9/3)
%     fprintf('rows: %d, %d, %d\n', (jx*3-2):jx*3)
%     for ix = 1:(9/3)
%         fprintf('\t%0.5e, %0.5e, %0.5e\n\t%0.5e, %0.5e, %0.5e\n\t%0.5e, %0.5e, %0.5e\n\n', diffA((jx*3-2):jx*3, (ix*3-2):ix*3))
%     end
% end



%% test target bearing H 
RCF_N = RCF1_Body2_N(:, :, 200);
[ynom, Hanalitical] = relNavRng_opTarget_meas_H(x_nonDimR, RCF_N, [9, 9]);

nx = length(x_nonDimR);
dx = [ones(3, 1)/L; ones(3, 1)*.01/L/n; ones(3, 1)*.0001/(1000*L)*tCharacteristic^2; ones(3, 1)/L; ones(3, 1)*.01/L/n; ones(3, 1)*.0001/(1000*L)*tCharacteristic^2]/1000000;

Hnumerical = 0*Hanalitical;
for ix=1:nx
    xp = x_nonDimR;
    xp(ix) = xp(ix)+dx(ix);
    [yp, dummy] = relNavRng_opTarget_meas_H(xp, RCF_N, [9, 9]);
%     xm = x;
%     xm(ix) = xm(ix)-dx(ix);
%     ym = pinHoleOpticalMeas_target(xm, RCF_N);
    Hnumerical(:,ix) = (yp-ynom)/dx(ix);
end
% Hnumerical, Hanalitical;

diffH = Hnumerical - Hanalitical;



for ix = 1:3
    fprintf('\t%0.5e, %0.5e, %0.5e \t%0.5e, %0.5e, %0.5e \t%0.5e, %0.5e, %0.5e \t\t\t%0.5e, %0.5e, %0.5e \t%0.5e, %0.5e, %0.5e \t%0.5e, %0.5e, %0.5e\n', diffH(ix, :))
end







