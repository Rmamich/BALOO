            end
            plotLabelLines = p1;
            if iiState == 1
                if flagPlotTitle
                    title(titles_states{iiStatePlot}, 'FontSize', fontSize)
                end
            elseif iiState == 3
                xlabel(strcat('Time ', timeUnit), 'FontSize',fontSize)
            end
            % grid minor
            if contains(flagPlotFrame, 'rtn')
                if flagEstChaserAccelBias
                    if iiStatePlot == nStateFigs
                        ylabel(strcat(baseAxis_accel{iiState}, ' ', axisUnits_states{iiStatePlot}), 'FontSize',fontSize)
                    else
                        ylabel(strcat(baseAxis{iiState}, ' ', axisUnits_states{iiStatePlot}),  'FontSize',fontSize)
                    end
                else
                    ylabel(strcat(baseAxis{iiState}, ' ', axisUnits_states{iiStatePlot}),  'FontSize',fontSize)
                end
            else
                ylabel(strcat(baseAxis{iiState}, ' ', axisUnits_states{iiStatePlot}),  'FontSize',fontSize)
            end
            if ~flagCovPlotOff
                % TODO: Put this back on
                % for iiMC = firstPlot:firstPlot
                %     diagPminus = covAll{iiMC, 1};
                %     diagPplus = covAll{iiMC, 2};
                %     p2 = plot(time, 3*diagPminus(iiStatePlot*3-(3-iiState), :), '.-g');
                %     plot(time, -3*diagPminus(iiStatePlot*3-(3-iiState), :), '.-g')
                %     p3 = plot(time, 3*diagPplus(iiStatePlot*3-(3-iiState), :), '--r');
                %     plot(time, -3*diagPplus(iiStatePlot*3-(3-iiState), :), '--r')
                %     plotLabelLines = [p1, p2, p3];
                % end
                p4 = plot(time, errAll(iiStatePlot*3-(3-iiState), :), 'k', 'LineWidth', line_width + 0.5);
                % p2 = plot(time, 3*covAllMCMinus(iiStatePlot*3-(3-iiState), :), '.-', 'Color', cyanCB);
                % plot(time, -3*covAllMCMinus(iiStatePlot*3-(3-iiState), :), '.-', 'Color', cyanCB)
                p5 = plot(time, 3*sigmaAll(iiStatePlot*3-(3-iiState), :), ':', 'Color', darkGreenCB, 'LineWidth', line_width);
                plot(time, -3*sigmaAll(iiStatePlot*3-(3-iiState), :), ':', 'Color', darkGreenCB, 'LineWidth', line_width)
                p3 = plot(time, 3*covAllMCPlus(iiStatePlot*3-(3-iiState), :), '--', 'Color', magentaCB, 'LineWidth', line_width);
                plot(time, -3*covAllMCPlus(iiStatePlot*3-(3-iiState), :), '--', 'Color', magentaCB, 'LineWidth', line_width)

                plotLabelLines = [p1,... % p2,...
                    p3, p5, p4];
                % for iiMC = plotList
                % diagPminus = covAll{firstPlot, 1};
                % diagPplus = covAll{firstPlot, 2};
                % p2 = plot(time, 3*diagPminus(iiStatePlot*3-(3-iiState), :), '.-g');
                % plot(time, -3*diagPminus(iiStatePlot*3-(3-iiState), :), '.-g')
                % p3 = plot(time, 3*diagPplus(iiStatePlot*3-(3-iiState), :), '--r');
                % plot(time, -3*diagPplus(iiStatePlot*3-(3-iiState), :), '--r')
                % plotLabelLines = [p1, p2, p3];
                % end
                legend(plotLabelLines, 'ith Run Error$^+$',... 'Avg $3\sigma^-$',
                    'Avg Filter $3\sigma^+$', 'Sample 3$\sigma^+$', 'Sample Avg Err$^+$', 'Interpreter','latex', 'location', 'BestOutside')
            end
            if strcmp(flagZoomSave, 'zoomEnd')
                xlim([xlimSet(1), xlimSet(2)])
            elseif strcmp(flagZoomSave, 'zoomAll')
                xlim(xlimSet)
            end
        end
        if saveFig
            figNameCells{figCount} = fullfile(figNameSave, strcat(figNames_states{iiStatePlot}, figNameEnd));
            exportgraphics(gcf, figNameCells{figCount}, 'resolution',300)
            % saveas(fig(figCount), fullfile(figNameSave, strcat(figNames_states{iiStatePlot}, figNameEnd)))
        end
        figCount = figCount + 1;
    end
    if flagLidarBias
        figName = strcat(flagScenario, flagGravModelTruth, flagGravModel, burnName, figNames_states{iiStatePlot+1});
        fig(figCount) = figure(figCount); % figure('Name',figName, 'NumberTitle','off');
        set(gcf, 'Position', figLoc)
        ax(countAx) = subplot(1, 1, 1);
        ax(countAx).FontSize = fontSize;
        ax(countAx).GridLineWidth = gridLineWidth;
        ax(countAx).LineWidth = axesLineWidth;
        countAx = countAx + 1;
        grid minor
        hold on
        box on

        for iiMC = plotList
            xErr = xErrAll{iiMC};
            p1 = plot(time, xErr(iiStatePlot*3-(3-iiState)+1, :), 'Color', darkGreenCB, 'LineWidth', line_width);
        end
        plotLabelLines = p1;
        legend(plotLabelLines, 'ith Run Error$^+$','Interpreter','latex', 'location', 'BestOutside')
        if flagPlotTitle
            title(titles_states{iiStatePlot+1}, 'FontSize',fontSize)
        end
        xlabel(strcat('Time ', timeUnit), 'FontSize',fontSize)
        % grid minor
        ylabel(strcat('Bias', axisUnits_states{iiStatePlot+1}),  'FontSize',fontSize)
        if ~flagCovPlotOff
            for iiMC = plotList
                diagPminus = covAll{iiMC, 1};
                diagPplus = covAll{iiMC, 2};
                p2 = plot(time, 3*diagPminus(iiStatePlot*3-(3-iiState)+1, :), '.-', 'Color', cyanCB, 'LineWidth', line_width);
                plot(time, -3*diagPminus(iiStatePlot*3-(3-iiState)+1, :), '.-', 'Color', cyanCB, 'LineWidth', line_width)
                p3 = plot(time, 3*diagPplus(iiStatePlot*3-(3-iiState)+1, :), '--', 'Color', magentaCB, 'LineWidth', line_width);
                plot(time, -3*diagPplus(iiStatePlot*3-(3-iiState)+1, :), '--', 'Color', magentaCB, 'LineWidth', line_width)
            end
            plotLabelLines = [p1, p2, p3];
            legend(plotLabelLines, 'ith Run Error$^+$', '$3\sigma^-$', '$3\sigma^+$','Interpreter','latex', 'location', 'BestOutside')
        end
        if strcmp(flagZoomSave, 'zoomEnd')
            xlim([xlimSet(1), xlimSet(2)])
        elseif strcmp(flagZoomSave, 'zoomAll')
            xlim(xlimSet)
        end
        if saveFig
            figNameCells{figCount} = fullfile(figNameSave, strcat(figNames_states{iiStatePlot+1}, figNameEnd));
            exportgraphics(gcf, figNameCells{figCount}, 'resolution',300)
            % saveas(fig(figCount), fullfile(figNameSave, strcat(figNames_states{iiStatePlot+1}, figNameEnd)))
        end
        figCount = figCount + 1;
    end
    linkaxes(ax,'x');
end

%% Covariance estimates
if contains(flagQ, 'CorrMethod')
    fig(figCount) = figure(figCount); % figure('Name',figName, 'NumberTitle','off');
    for j = 1:3
        set(gcf, 'Position', figLoc)
        ax(countAx) = subplot(3, 1, j);
        ax(countAx).FontSize = fontSize;
        ax(countAx).GridLineWidth = gridLineWidth;
        ax(countAx).LineWidth = axesLineWidth;
        grid minor
        hold on
        box on
        countAx = countAx + 1;
        for iiMC = plotList
            qkErr = qCountDiagErrAll{iiMC};
            qCountDiagCovSigma = qCovAll{iiMC};
            p1 = plot(time, qkErr(j, :), 'color', darkGreenCB, 'LineWidth', line_width);
            p2 = plot(time, 3*qCountDiagCovSigma(j, :), '--', 'color', magentaCB, 'LineWidth', line_width);
            plot(time, -3*qCountDiagCovSigma(j, :), '--', 'color', magentaCB, 'LineWidth', line_width);
        end
        if strcmp(flagZoomSave, 'zoomEnd')
            xlim([xlimSet(1), xlimSet(2)])
        elseif strcmp(flagZoomSave, 'zoomAll')
            xlim(xlimSet)
        end
        plotLabelLines = [p1, p2];
        legend(plotLabelLines, 'ith Run Error$^+$', '$3\sigma^+$', 'Interpreter','latex', 'location', 'BestOutside')
        if j == 1
            if flagPlotTitle
                title('$\sqrt{diag(\mathbf{Q})}$ Error')
            end
        elseif j == 3
            xlabel(strcat('Time ', timeUnit))
        end
        ylabel(strcat('$\sqrt{Q_', num2str(j), '} [(m/s^2)]$'), 'Interpreter',textInterpreter)
    end
    if saveFig
        figNameCells{figCount} = fullfile(figNameSave, strcat('sqrtQcountDiagError_Qtruth_neg', num2str(qkminus0(1, 1)),figNameEnd));
        exportgraphics(gcf, figNameCells{figCount}, 'resolution',300)
        % saveas(fig(figCount), fullfile(figNameSave, strcat('QcountDiag_Qtruth_neg', num2str(qkminus0(1, 1)),figNameEnd)))
    end
    figCount = figCount + 1;
    fig(figCount) = figure(figCount); % figure('Name',figName, 'NumberTitle','off');
    for j = 1:3
        set(gcf, 'Position', figLoc)
        ax(countAx) = subplot(3, 1, j);
        ax(countAx).FontSize = fontSize;
        ax(countAx).GridLineWidth = gridLineWidth;
        ax(countAx).LineWidth = axesLineWidth;
        grid minor
        hold on
        countAx = countAx + 1;
        for iiMC = plotList
            qCountDiag = qCountDiagAll{iiMC};
            p1 = plot(time, qCountDiag(j, :), 'color', darkGreenCB, 'LineWidth', line_width);
        end
        plot(time, -qkminus0(j, :)*ones(1, N), 'color', magentaCB, 'LineWidth', line_width);
        p2 = plot(time, qkminus0(j, :)*ones(1, N), 'color', magentaCB, 'LineWidth', line_width);
        plotLabelLines = [p1, p2];
        legend(plotLabelLines, 'Est', 'Truth', 'Interpreter','latex', 'location', 'BestOutside')
        if j == 1
            if flagPlotTitle
                title('$\sqrt{diag(\mathbf{Q})}$')
            end
        elseif j == 3
            xlabel(strcat('Time ', timeUnit))
        end
        ylabel(strcat('$\sqrt{Q_', num2str(j), '} [(m/s^2)]$'), 'Interpreter',textInterpreter)
        if strcmp(flagZoomSave, 'zoomEnd')
            xlim([xlimSet(1), xlimSet(2)])
        elseif strcmp(flagZoomSave, 'zoomAll')
            xlim(xlimSet)
        end
    end
    if saveFig
        % fig(figCount) = gcf;
        figNameCells{figCount} = fullfile(figNameSave, strcat('QcountDiag_Qtruth_neg', num2str(qkminus0(1, 1)),figNameEnd));
        exportgraphics(gcf, figNameCells{figCount}, 'resolution',300)
        % saveas(fig(figCount), fullfile(figNameSave, strcat('QcountDiag_Qtruth_neg', num2str(qkminus0(1, 1)),figNameEnd)))
    end






    linkaxes(ax,'x');
else
    figCount = figCount - 1;
end

