        for iiState = 1:3
            ax(countAx) = subplot(3, 1, iiState);
            ax(countAx).FontSize = fontSize;
            ax(countAx).GridLineWidth = gridLineWidth;
            ax(countAx).LineWidth = axesLineWidth;
            set(gcf, 'Position', figLoc)
