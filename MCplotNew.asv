%house keeping
if ~exist('flagSetFlags', 'var')
    clear
    close all

    expNum = 14;
    nMC = 100;

    saveFig = true;                                   % Saves plots when true
    % baseFilepath = fullfile('.', 'Figures');          % Sets base file path for Figure saving
    baseFilepath = fullfile('Figures');          % Sets base file path for Figure saving
    baseName = 'simpleSim';                           % Sets base name for Figure saving
    timeUnit = '[min]';                                 % Sets time axis to be in hours when plotting
    angUnit = '[deg]';                                 % Sets time axis to be in hours when plotting
    flagAccel = false;                                % adds acceleration to state when true
    flagGravModel = 'j2On';                           % Sets up grav param to be on or off
    flagGravModelTruth = 'j2On';                      % Sets label for saving data with the truth data model
    flagScenario = 'KayhanRelWSE2SE'; % 'Erros';             % Sets central body for sim you want to run
    flagFilterType = 'EKF';
    flagBurnOn = true;                               % Zeros our burn hist when set to false
    flagAccelerometerPerfectMatch = true;                      % When true, uses imperfect burn that matches the truth when false, matches commanded burn
    fileBase = fullfile('.', 'MAT', flagScenario); % Sets base file path for Figure .mat file read in
    plotStates = true;
    flagCovPlotOff = false;
    qkminus0 = 1e-9;
    firstPlot = 1;
    flagPlotFrame = 'rtn';
    plotExclude = [];
    fontSize = 28;
    line_width = 3;
    textInterpreter = 'latex';
    set(0, 'DefaultTextInterpreter', 'latex')
    set(0, 'DefaultLegendInterpreter', 'latex')
    axesLineWidth = 2;
    gridLineWidth = 1;
    markerSize = 3;
    flagZoomSave = 'none';
    flagGenCellsForPlotting = true;
    flagPlotTitle = true;
end

% blueCB = [68 , 119, 170]/255;
% redCB = [238, 102, 119;]/255;
