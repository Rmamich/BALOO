%% Implement Flags
if flagAccelerometerPerfectMatch
    burnName = '_noNoiseAccelerometer';
else
    burnName = '_noisyAccelerometer';
end

if ~flagBurnOn
    burnName = '_noBurn';
end

procNoiseName = '';
n_exp = length(expNum);
Q0 = zeros(3*n_exp);
for i = 1:n_exp
    if expNum(i) == 0
        Q0(((i*3-2):i*3), ((i*3-2):i*3)) = zeros(3);
        procNoiseName = strcat(procNoiseName, '_zeroQ');
    else
        Q0(((i*3-2):i*3), ((i*3-2):i*3)) = eye(3)*10^(-expNum(i)); % 1e-6 is good for no accel -- 1e-12 is good for accel on
        procNoiseName = strcat('_nonzeroQ_eneg', num2str(expNum(i)));
    end
end

if ~flagEstTargetAccel && ~flagEstChaserAccelBias
    ChaserStates = 7:12;
    if contains(flagScenario, 'Rel')
        titles_states = {'$\mathbf{r}_{t/c}$ Errors v Time', '$\mathbf{v}_{t/c}$ Errors v Time', '$\mathbf{r}_{c}$ Errors v Time', '$\mathbf{v}_{c}$ Errors v Time'};
        axisUnits_states = {'[$m$]', '[$m/s$]', '[$m$]', '[$m/s$]'};
        figNames_states = {'RelPos', 'RelVel', 'ChaserPos', 'ChaserVel'};
    else
        titles_states = {'$\mathbf{r}_{t}$ Errors v Time', '$\mathbf{v}_{t}$ Errors v Time', '$\mathbf{r}_{c}$ Errors v Time', '$\mathbf{v}_{c}$ Errors v Time'};
        axisUnits_states = {'[$m$]', '[$m/s$]', '[$m$]', '[$m/s$]'};
        figNames_states = {'TargetPos', 'TargetVel', 'ChaserPos', 'ChaserVel'};
    end
    accelName = 'accelOffBiasOff';
    if flagLidarBias
        nStateFigs = 4;
        truthState = truthState([1:6, 10:15, 19], :);
        n = 13;
    else
        nStateFigs = 4;
        truthState = truthState([1:6, 10:15], :);
        n = 12;
    end
elseif ~flagEstTargetAccel && flagEstChaserAccelBias
    ChaserStates = 7:15;
    if contains(flagScenario, 'Rel')
        titles_states = {'$\mathbf{r}_{t/c}$ Errors v Time', '$\mathbf{v}_{t/c}$ Errors v Time', '$\mathbf{r}_{c}$ Errors v Time', '$\mathbf{v}_{c}$ Errors v Time', '$\mathbf{b}_{c}$ Errors v Time'};
        axisUnits_states = {'[$m$]', '[$m/s$]', '[$m$]', '[$m/s$]', '[$m/s^2$]'};
        figNames_states = {'RelPos', 'RelVel', 'ChaserPos', 'ChaserVel', 'ChaserBias'};
    else
        titles_states = {'$\mathbf{r}_{t}$ Errors v Time', '$\mathbf{v}_{t}$ Errors v Time', '$\mathbf{r}_{c}$ Errors v Time', '$\mathbf{v}_{c}$ Errors v Time', '$\mathbf{b}_{c}$ Errors v Time'};
        axisUnits_states = {'[$m$]', '[$m/s$]', '[$m$]', '[$m/s$]', '[$m/s^2$]'};
        figNames_states = {'TargetPos', 'TargetVel', 'ChaserPos', 'ChaserVel', 'ChaserBias'};
    end
    accelName = 'accelOffBiasOn';
    if flagLidarBias
        nStateFigs = 5;
        truthState = truthState([1:6, 10:19], :);
        n = 16;
    else
        nStateFigs = 5;
        truthState = truthState([1:6, 10:18], :);
        n = 15;
    end
elseif flagEstTargetAccel && flagEstChaserAccelBias
    ChaserStates = 10:18;
    if contains(flagScenario, 'Rel')
        titles_states = {'$\mathbf{r}_{t/c}$ Errors v Time', '$\mathbf{v}_{t/c}$ Errors v Time', '$\mathbf{a}_{t}$ Errors v Time', '$\mathbf{r}_{c}$ Errors v Time', '$\mathbf{v}_{c}$ Errors v Time', '$\mathbf{b}_{c}$ Errors v Time'};
        axisUnits_states = {'[$m$]', '[$m/s$]', '[$m/s^2$]', '[$m$]', '[$m/s$]', '[$m/s^2$]'};
        figNames_states = {'RelPos', 'RelVel', 'RelAccel', 'ChaserPos', 'ChaserVel', 'ChaserBias'};
    else
        titles_states = {'$\mathbf{r}_{t}$ Errors v Time', '$\mathbf{v}_{t}$ Errors v Time', '$\mathbf{a}_{t}$ Errors v Time', '$\mathbf{r}_{c}$ Errors v Time', '$\mathbf{v}_{c}$ Errors v Time', '$\mathbf{b}_c$ Errors v Time'};
        axisUnits_states = {'[$m$]', '[$m/s$]', '[$m/s^2$]', '[$m$]', '[$m/s$]', '[$m/s^2$]'};
        figNames_states = {'TargetPos', 'TargetVel', 'TargetAccel', 'ChaserPos', 'ChaserVel', 'ChaserBias'};
    end
    accelName = 'accelOnBiasOn';
    if flagLidarBias
        nStateFigs = 6;
        n = 19;
    else
        nStateFigs = 6;
        truthState = truthState(1:18, :);
        n = 18;
    end
elseif flagEstTargetAccel && ~flagEstChaserAccelBias
    ChaserStates = 10:15;
    if contains(flagScenario, 'Rel')
        titles_states = {'$\mathbf{r}_{t/c}$ Errors v Time', '$\mathbf{v}_{t/c}$ Errors v Time', '$\mathbf{a}_{t}$ Errors v Time', '$\mathbf{r}_{c}$ Errors v Time', '$\mathbf{v}_{c}$ Errors v Time'};
        axisUnits_states = {'[$m$]', '[$m/s$]', '[$m/s^2$]', '[$m$]', '[$m/s$]'};
        figNames_states = {'RelPos', 'RelVel', 'RelAccel', 'ChaserPos', 'ChaserVel'};
    else
        titles_states = {'$\mathbf{r}_{t}$ Errors v Time', '$\mathbf{v}_{t}$ Errors v Time', '$\mathbf{a}_{t}$ Errors v Time', '$\mathbf{r}_{c}$ Errors v Time', '$\mathbf{v}_{c}$ Errors v Time'};
        axisUnits_states = {'[$m$]', '[$m/s$]', '[$m/s^2$]', '[$m$]', '[$m/s$]'};
        figNames_states = {'TargetPos', 'TargetVel', 'TargetAccel', 'ChaserPos', 'ChaserVel'};
    end
    accelName = 'accelOnBiasOff';
    if flagLidarBias
        nStateFigs = 5;
        truthState = truthState([1:15, 19], :);
        n = 16;
    else
        nStateFigs = 5;
        truthState = truthState(1:15, :);
        n = 15;
    end
end

if flagLidarBias
    titles_states{nStateFigs+1} = 'Lidar Bias Errors v Time';
    axisUnits_states{nStateFigs+1} = '[$m$]';
    figNames_states{nStateFigs+1} = 'LidarBias';
    accelName = strcat(accelName, 'LidarBiasOn');
else
    accelName = strcat(accelName, 'LidarBiasOff');
end

%% Measurement Flag Handling

[m, ~] = size(meas);

if m == 3
    if contains(flagScenario, 'direct')
        titlesRes = {'Relative Range [X] Residuals v Time', 'Relative Range [Y] Residuals v Time', 'Relative Range [Z] Residuals v Time'};
        titlesMeas = {'Relative Range [X] v Time', 'Relative Range [Y] v Time', 'Relative Range [Z] v Time'};
        figNameMeas = {'RngX', 'RngY', 'RngZ'};
        resUnits = {'Range [$m$]', 'Range [$m$]', 'Range [$m$]'};
    else
        titlesRes = {'Range Residuals v Time', 'Relative Azimuth Residuals v Time', 'Relative Elevation Residuals v Time'};
        titlesMeas = {'Range v Time', 'Relative Azimuth v Time', 'Relative Elevation v Time'};
        figNameMeas = {'Rng', 'RelAz', 'RelEl'};
        resUnits = {'Range [$m$]', 'Az ', 'El '};
    end
elseif m == 5
    titlesRes = {'Range Residuals v Time', 'Relative Azimuth Residuals v Time', 'Relative Elevation Residuals v Time', 'Feature Azimuth Residuals v Time', 'Feature Elevation Residuals v Time'};
    titlesMeas = {'Range v Time', 'Relative Azimuth v Time', 'Relative Elevation v Time', 'Feature Azimuth v Time', 'Feature Elevation v Time'};
    figNameMeas = {'Rng', 'RelAz', 'RelEl', 'FeatureAz', 'FeatureEl'};
    resUnits = {'Range [$m$]', 'Az ', 'El ', 'Az ', 'El '};
elseif m == 6
    titlesRes = {'Range Residuals v Time', 'Range Rate Residuals v Time', 'Relative Azimuth Residuals v Time', 'Relative Elevation Residuals v Time', 'Feature Azimuth Residuals v Time', 'Feature Elevation Residuals v Time'};
    titlesMeas = {'Range v Time', 'Range Rate v Time', 'Relative Azimuth v Time', 'Relative Elevation v Time', 'Feature Azimuth v Time', 'Feature Elevation v Time'};
    figNameMeas = {'Rng', 'RngRate', 'RelAz', 'RelEl', 'FeatureAz', 'FeatureEl'};
    resUnits = {'Range [$m$]', 'RangeRate [$m/s$]', 'Az ', 'El ', 'Az ', 'El '};
end
if contains(flagPlotFrame, 'rtn')
    baseAxis = {'R', 'T', 'N'};
    baseAxis_accel = {'X', 'Y', 'Z'};
else
    baseAxis = {'X', 'Y', 'Z'};
end
mcName = strcat('MC', num2str(nMC));

figNameSave = fullfile(baseFilepath, flagScenario, flagFilterType, mcName, strcat(accelName, flagGravModelTruth,flagGravModel, burnName, procNoiseName));

if flagInitCovStudy
    figNameSave = fullfile(baseFilepath, flagScenario, flagFilterType, strcat('InitCovFactor', P0str{iiP0}),mcName, strcat(accelName, flagGravModelTruth,flagGravModel, burnName, procNoiseName));
else
    figNameSave = fullfile(baseFilepath, flagScenario, flagFilterType, mcName, strcat(accelName, flagGravModelTruth,flagGravModel, burnName, procNoiseName));
end


if ~exist(figNameSave, 'dir')
    mkdir(figNameSave)
end

% if strcmp(timeUnit, '[h]')
%     time = time / 3600; % Convert to Hours
% elseif strcmp(timeUnit, '[min]')
%     time = time / 60; % Convert to min
% end

if strcmp(flagZoomSave, 'zoomEnd')
    figNameEnd = '_zoomedEnd.png';
elseif strcmp(flagZoomSave, 'zoomAll')
    figNameEnd  ='_zoomedAll.png';
else
    figNameEnd = '.png';
end


%% Data Proceeing for Plotting
n = sum(n_elm);
N = length(time);
% fileNameSaveCells = fullfile(fileBase, strcat(accelName, flagGravModelTruth, flagGravModel, burnName), 'fullCells');
plotList = firstPlot:nMC;
if ~flagEstTargetAccel && ~flagEstChaserAccelBias
    accelName = 'accelOffBiasOff';
    if flagLidarBias
        truthState = truthState([1:6, 10:15, 19], :);
    else
        truthState = truthState([1:6, 10:15], :);
    end
    targetStates = 1:6;
    deputyStates = 7:12;
elseif ~flagEstTargetAccel && flagEstChaserAccelBias
    if flagLidarBias
        truthState = truthState([1:6, 10:19], :);
    else
        % truthState = truthState([1:6, 10:18], :);
    end
    targetStates = 1:6;
    deputyStates = 7:15;
elseif flagEstTargetAccel && ~flagEstChaserAccelBias
    if flagLidarBias
        truthState = truthState([1:15, 19], :);
    else
        truthState = truthState(1:15, :);
    end
    targetStates = 1:9;
    deputyStates = 10:15;
else
    if ~flagLidarBias
        truthState = truthState(1:18, :);
    end
    targetStates = 1:9;
    deputyStates = 10:18;
end

fileNameSaveCells = fullfile(fileBase, strcat(accelName, flagGravModelTruth, flagGravModel, burnName), 'fullCells');

if ~flagGenCellsForPlotting
    if ~exist(fullfile(fileNameSaveCells, 'sigmaSquareAll.mat'), 'file')
        flagGenCellsForPlotting = true;
    end
end



if flagGenCellsForPlotting
    if ~exist(fileNameSaveCells, 'dir')
        mkdir(fileNameSaveCells)
    end
    % Memory Allocation
    xErrAll = cell(1, nMC);
    covAll = cell(nMC, 2);
    measAll = cell(1, nMC);
    resAll = cell(nMC, 2);
    resCovAll = cell(nMC, 2);
    resCovAll_sample = cell(nMC, 2);
    qCountDiagErrAll = cell(nMC);
    qCountDiagAll = cell(nMC);
    qCovAll = cell(1, nMC);
    covAllMCPlus = zeros(n, N);
    covAllMCMinus = zeros(n, N);
    PyyAllMCMinus = zeros(m, N);
    errAll = zeros(n, N);
    sigmaAll = zeros(n, N);
    sigmaSquareAll = zeros(n, n, N);
    meas_sampCov_minus = NaN(nMC, m, N);
    meas_sampCov_plus = NaN(nMC, m, N);


    if ~isempty(plotExclude)
        n_exclude = length(plotExclude);
        for i = 1:n_exclude
            plotList = plotList(plotList~=plotExclude(i));
        end
    end

    for ii = plotList
        % Loops over MC runs for each alt
        % Read in run data
        fileNameLoad = fullfile(fileBase, strcat(accelName, flagGravModelTruth, flagGravModel, burnName), strcat('MC_', num2str(ii)));
        load(fullfile(fileNameLoad, 'xhist.mat'))
        load(fullfile(fileNameLoad, 'PPlushist.mat'))
        load(fullfile(fileNameLoad, 'Pminushist.mat'))
        load(fullfile(fileNameLoad, 'riPlushist.mat'))
        load(fullfile(fileNameLoad, 'riMinushist.mat'))
        load(fullfile(fileNameLoad, 'PriPlushist.mat'))
        load(fullfile(fileNameLoad, 'PriMinushist.mat'))
        load(fullfile(fileNameLoad, 'meas_runhist.mat'))
        load(fullfile(fileNameLoad, 'numNodes.mat'));%, 'num_nodesPlot')
        load(fullfile(fileBase, strcat('truthStateMC', num2str(ii), '.mat')))
        load(fullfile(fileBase, strcat('truemeasMC', num2str(ii),'.mat')))
        if contains(flagQ, 'CorrMethod')
            load(fullfile(fileNameLoad, 'qCountDiag_runhist.mat'))
            load(fullfile(fileNameLoad, 'qCov.mat'))
        end
        if ~flagEstTargetAccel && ~flagEstChaserAccelBias
            accelName = 'accelOffBiasOff';
            if flagLidarBias
                truthState = truthState([1:6, 10:15, 19], :);
            else
                truthState = truthState([1:6, 10:15], :);
            end
            targetStates = 1:6;
            deputyStates = 7:12;
        elseif ~flagEstTargetAccel && flagEstChaserAccelBias
            if flagLidarBias
                truthState = truthState([1:6, 10:19], :);
            else
                truthState = truthState([1:6, 10:18], :);
            end
            targetStates = 1:6;
            deputyStates = 7:15;
        elseif flagEstTargetAccel && ~flagEstChaserAccelBias
            if flagLidarBias
                truthState = truthState([1:15, 19], :);
            else
                truthState = truthState(1:15, :);
            end
            targetStates = 1:9;
            deputyStates = 10:15;
        else
            if ~flagLidarBias
                truthState = truthState(1:18, :);
            end
            targetStates = 1:9;
            deputyStates = 10:18;
        end

        if contains(flagScenario, 'nonDim')
            mu = 0.012150584270; % mass ratio from paper
            L = 384400; % km -- characteristic length
            L_m = L*1000;% m
            tCharacteristic = 3.751902619517e5; % s -- characteristic time from paper

            PNondim = 1.511143593137; % period non dimensional from paper

            tDim = PNondim*tCharacteristic; % dimensional period -- convert as nondimensional period * characteristic time
            P_rot = tDim; %
            n_rot = 2*pi/P_rot; % 1/s
            % Convert everything to dimensional/inertial
            % State history
            for i = 1:N
                if contains(flagScenario, 'Rel')
                    % Get full inertial state first
                    if n_elm(1) > 6
                        truth_N =  [truthState(targetStates(1:6), i) + truthState(ChaserStates(1:6), i); truthState(targetStates(7:9), i); truthState(ChaserStates, i)];
                        x_N =  [x(targetStates(1:6), i) + x(ChaserStates(1:6), i); x(targetStates(7:9), i); x(ChaserStates, i)];
                    else
                        truth_N =  [truthState(targetStates(1:6), i) + truthState(ChaserStates(1:6), i); truthState(ChaserStates, i)];
                        x_N =  [x(targetStates(1:6), i) + x(ChaserStates(1:6), i); x(ChaserStates, i)];
                    end
                end

                % Now convert to inertial and dimensional
                truth_N = nonDimRotational_dimInertial_conversion(truth_N, time(i)*tCharacteristic, L_m, n_rot, tCharacteristic, 'fullState_nondimR2dimN');
                x_N = nonDimRotational_dimInertial_conversion(x_N, time(i)*tCharacteristic, L_m, n_rot, tCharacteristic, 'fullState_nondimR2dimN');

                if contains(flagScenario, 'Rel')
                    % Now put things back into relNav States
                    if n_elm(1) > 6
                        truth_N =  [truth_N(targetStates(1:6)) - truth_N(ChaserStates(1:6)); truth_N(targetStates(7:9)); truth_N(ChaserStates)];
                        x_N =  [x_N(targetStates(1:6)) - x_N(ChaserStates(1:6)); x_N(targetStates(7:9)); x_N(ChaserStates)];
                    else
                        truth_N =  [truth_N(targetStates(1:6)) -truth_N(ChaserStates(1:6)); truth_N(ChaserStates)];
                        x_N =  [x_N(targetStates(1:6)) - x_N(ChaserStates(1:6)); x_N(ChaserStates)];
                    end
                end

                truthState(:, i) = truth_N;
                x(:, i) = x_N;
            end

            % Now convert the covariance matrices
            for i = 1:N
                P_dim = P(:, :, i);
                dX_nonDimR_dX_dimN_c = dX_nonDimRot_dX_dimN(0, time(i)*tCharacteristic, [mu, L_m, n_rot, tCharacteristic]);
                dX_dimN_dX_nonDimR_c = dX_dimN_dX_nonDimRot(0, time(i)*tCharacteristic, [mu, L_m, n_rot, tCharacteristic]);
                P_dim(ChaserStates, ChaserStates) = dX_dimN_dX_nonDimR_c*P_dim(ChaserStates, ChaserStates)*dX_dimN_dX_nonDimR_c';

                % Target
                dX_nonDimR_dX_dimN_t = dX_nonDimRot_dX_dimN(0, time(i)*tCharacteristic, [mu, L_m, n_rot, tCharacteristic]);
                dX_dimN_dX_nonDimR_t = dX_dimN_dX_nonDimRot(0, time(i)*tCharacteristic, [mu, L_m, n_rot, tCharacteristic]);
                P_dim(targetStates, targetStates) = dX_dimN_dX_nonDimR_t*P_dim(targetStates, targetStates)*dX_dimN_dX_nonDimR_t';

                P(:, :, i) = P_dim;

                Pminus_dim = Pminus(:, :, i);
                Pminus_dim(ChaserStates, ChaserStates) = dX_dimN_dX_nonDimR_c*Pminus_dim(ChaserStates, ChaserStates)*dX_dimN_dX_nonDimR_c';

                % Target
                Pminus_dim(targetStates, targetStates) = dX_dimN_dX_nonDimR_t*Pminus_dim(targetStates, targetStates)*dX_dimN_dX_nonDimR_t';

                Pminus(:, :, i) = Pminus_dim;
            end
        end



        [~, N] = size(x);
        [m, ~] = size(meas_run);

        plotFrame = zeros(3, 3, 2, N);
        if contains(flagPlotFrame, 'rtn')
            for i = 1:N
                if contains(flagScenario, 'Rel')
                    xt_N = truthState(targetStates(1:6), i) + truthState(ChaserStates(1:6), i);
                else
                    xt_N = truthState(targetStates(1:6), i);
                end
                [RTN_N] = inertial2rtn(xt_N);
                plotFrame(:, :, 1, i) = RTN_N;
                xc_N = truthState(ChaserStates(1:6), i);
                [RTN_N] = inertial2rtn(xc_N);
                plotFrame(:, :, 2, i) = RTN_N;
            end
        else
            for i = 1:N
                plotFrame(:, :, 1, i) = eye(3);
                plotFrame(:, :, 2, i) = eye(3);
            end
        end
        

        xErr = truthState - x;
        for i = 1:N
            plotFrame_i = eye(n);
            plotFrame_i(targetStates(1:3), targetStates(1:3)) = plotFrame(:, :, 1, i);
            plotFrame_i(targetStates(4:6), targetStates(4:6)) = plotFrame(:, :, 1, i);
            if n_elm(1) == 9
                plotFrame_i(targetStates(7:9), targetStates(7:9)) = plotFrame(:, :, 1, i);
            end
            plotFrame_i(ChaserStates(1:3), ChaserStates(1:3)) = plotFrame(:, :, 2, i);
            plotFrame_i(ChaserStates(4:6), ChaserStates(4:6)) = plotFrame(:, :, 2, i);
            xErr(:, i) = plotFrame_i*xErr(:, i);
        end
        errAll = errAll + xErr;
        xErrAll{ii} = xErr;
        if contains(flagQ, 'CorrMethod')
            qCountDiagErrAllTemp = NaN(3, N);
            for i = 1:N
                if ~isnan(qCountDiag(1, i))
                    qCountDiagErrAllTemp(:, i) = plotFrame(:, :, i)*(sign(qCountDiag(:, i)).*qkminus0 - qCountDiag(:, i));
                end
            end
            qCountDiagErrAll{ii} = qCountDiagErrAllTemp;
            qCountDiagAll{ii} = plotFrame(:, :, i)*qCountDiag;
        end

        % Process Data
        diagPplus = NaN(n, N);
        diagPminus = NaN(n, N);
        diagPyyPlus = NaN(m, N);
        diagPyyMinus = NaN(m, N);
        qCountDiagCovSigma = NaN(3, N);

        for i = 1:N
            plotFrame_i = eye(n);
            plotFrame_i(targetStates(1:3), targetStates(1:3)) = plotFrame(:, :, 1, i);
            plotFrame_i(targetStates(4:6), targetStates(4:6)) = plotFrame(:, :, 1, i);
            if n_elm(1) == 9
                plotFrame_i(targetStates(7:9), targetStates(7:9)) = plotFrame(:, :, 1, i);
            end
            plotFrame_i(ChaserStates(1:3), ChaserStates(1:3)) = plotFrame(:, :, 2, i);
            plotFrame_i(ChaserStates(4:6), ChaserStates(4:6)) = plotFrame(:, :, 2, i);
            diagPplus(:, i) = sqrt(diag(squeeze(plotFrame_i*P(:, :, i)*plotFrame_i')));
            covAllMCPlus(:, i) = covAllMCPlus(:, i) + diagPplus(:, i).^2;
            diagPminus(:, i) = sqrt(diag(squeeze(plotFrame_i*Pminus(:, :, i)*plotFrame_i')));
            covAllMCMinus(:, i) = covAllMCMinus(:, i) + diagPminus(:, i).^2;
            diagPyyPlus(:, i) = sqrt(diag(squeeze(Pri(:, :, i))));
            diagPyyMinus(:, i) = sqrt(diag(squeeze(PriMinus(:, :, i))));
            PyyAllMCMinus(:, i) = PyyAllMCMinus(:, i) + diagPyyMinus(:, i).^2;
            if contains(flagQ, 'Corr')
                qCountDiagCovSigma(:, i) = sqrt(diag(plotFrame(:, :, i)*qCountDiagCov(:, :, i)*plotFrame(:, :, i)'));
            end
        end

        riMinus_mean = mean(riMinus, 2, 'omitnan');
        riPlus_mean = mean(riPlus, 2, 'omitnan');
        meas_sampCov_ii_i_minus = zeros(m);
        meas_sampCov_ii_i_plus = zeros(m);
        for i = 2:N
            % meas_sampCov_ii_i_minus = (riMinus(:, i) - riMinus_mean)*(riMinus(:, i) - riMinus_mean)';
            % meas_sampCov_ii_i_plus = (riPlus(:, i) - riPlus_mean)*(riPlus(:, i) - riPlus_mean)';
            meas_sampCov_ii_i_minus = riMinus(:, i)*riMinus(:, i)';
            meas_sampCov_ii_i_plus = riPlus(:, i)*riPlus(:, i)';
            meas_sampCov_minus(ii, :, i) = diag(meas_sampCov_ii_i_minus);
            meas_sampCov_plus(ii, :, i) = diag(meas_sampCov_ii_i_plus);
        end


        if ~contains(flagScenario, 'direct')
            if strcmp(angUnit, '[deg]')
                riMinus(2:m, :) = riMinus(2:m, :)*180/pi;
                riPlus(2:m, :) = riPlus(2:m, :)*180/pi;
                diagPyyMinus(2:m, :) = diagPyyMinus(2:m, :)*180/pi;
                diagPyyPlus(2:m, :) = diagPyyPlus(2:m, :)*180/pi;
                meas_run(2:m, :) = meas_run(2:m, :)*180/pi;
                meas_sampCov_minus(ii, 2:m, :) = meas_sampCov_minus(ii, 2:m, :)*(180/pi)^2;
                meas_sampCov_plus(ii, 2:m, :) = meas_sampCov_plus(ii, 2:m, :)*(180/pi)^2;
            end
            if contains(flagScenario, 'nonDim')
                riMinus(1, :) = riMinus(1, :)*L_m;
                riPlus(1, :) = riPlus(1, :)*L_m;
                diagPyyMinus(1, :) = diagPyyMinus(1, :)*L_m;
                diagPyyPlus(1, :) = diagPyyPlus(1, :)*L_m;
                meas_run(1, :) = meas_run(1, :)*L_m;
                meas_sampCov_minus(ii, 1, :) = meas_sampCov_minus(ii, 1, :)*(L_m)^2;
                meas_sampCov_plus(ii, 1, :) = meas_sampCov_plus(ii, 1, :)*(L_m)^2;
            end
        else
            angUnit = '';
        end

        

        covAll{ii, 1} = diagPminus;
        covAll{ii, 2} = diagPplus;
        resCovAll{ii, 1} = diagPyyMinus;
        resCovAll{ii, 2} = diagPyyPlus;
        qCovAll{ii} = qCountDiagCovSigma;



        measAll{ii} = meas_run;
        resAll{ii, 1} = riMinus;
        resAll{ii, 2} = riPlus;
    end

    if ~contains(flagScenario, 'direct')
        if strcmp(angUnit, '[deg]')
            PyyAllMCMinus(2:m, :) = PyyAllMCMinus(2:m, :)*(180/pi)^2;
        end
        if contains(flagScenario, 'nonDim')
            PyyAllMCMinus(1, :) = PyyAllMCMinus(1, :)*(L_m)^2;
        end
    end
    
    if nMC - firstPlot > 0
        covAllMCPlus = covAllMCPlus/(nMC-firstPlot);
        covAllMCMinus = covAllMCMinus/(nMC-firstPlot);
        PyyAllMCMinus = PyyAllMCMinus/(nMC-firstPlot);
        errAll = errAll/(nMC-firstPlot);
    end

    for i = 1:N
        covAllMCPlus(:, i) = sqrt(covAllMCPlus(:, i));
        covAllMCMinus(:, i) = sqrt(covAllMCMinus(:, i));
        PyyAllMCMinus(:, i) = sqrt(PyyAllMCMinus(:, i));
    end

    for ii_k = 1:N
        for ii = plotList
            xErr = xErrAll{ii};
            % sigmaSquareAll(:, :, ii_k) = sigmaSquareAll(:, :, ii_k) + (errAll(:, ii_k) - squeeze(xErr(:, ii_k)))*(errAll(:, ii_k) - squeeze(xErr(:, ii_k)))';
            sigmaSquareAll(:, :, ii_k) = sigmaSquareAll(:, :, ii_k) + squeeze(xErr(:, ii_k))*squeeze(xErr(:, ii_k))';
        end
    end

    if nMC - firstPlot > 0
        sigmaSquareAll = sigmaSquareAll/(nMC-firstPlot);
    end

    for ii_k = 1:N
        sigmaAll(:, ii_k) = sqrt(diag(sigmaSquareAll(:, :, ii_k)));
    end

    meas_sampCov_minus_avg = sqrt(squeeze(mean(meas_sampCov_minus, 1, 'omitnan')));
    meas_sampCov_plus_avg = sqrt(squeeze(mean(meas_sampCov_plus, 1, 'omitnan')));

    % figure
    % for jj_test = 1:3
    %     subplot(3, 1, jj_test)
    %     hold on
    %     for ii_test = 1:nMC
    %         plot(time, squeeze(meas_sampCov_minus(ii_test, jj_test, :)))
    %     end
    %     plot(time, meas_sampCov_minus_avg(jj_test, :), 'k', 'linewidth', 3)
    % end

    % if ~contains(flagScenario, 'direct')
    %     if strcmp(angUnit, '[deg]')
    %         riMinus(2:m, :) = riMinus(2:m, :)*180/pi;
    %         riPlus(2:m, :) = riPlus(2:m, :)*180/pi;
    %         diagPyyMinus(2:m, :) = diagPyyMinus(2:m, :)*180/pi;
    %         diagPyyPlus(2:m, :) = diagPyyPlus(2:m, :)*180/pi;
    %         meas_run(2:m, :) = meas_run(2:m, :)*180/pi;
    %     end
    % else
    %     angUnit = '';
    % end

    save(fullfile(fileNameSaveCells, 'xErr.mat'), "xErrAll")
    save(fullfile(fileNameSaveCells, 'covAll.mat'), "covAll")
    save(fullfile(fileNameSaveCells, 'measAll.mat'), "measAll")
    save(fullfile(fileNameSaveCells, 'resAll.mat'), "resAll")
    save(fullfile(fileNameSaveCells, 'resCovAll.mat'), "resCovAll")
    save(fullfile(fileNameSaveCells, 'qCountDiagErrAll.mat'), "qCountDiagErrAll")
    save(fullfile(fileNameSaveCells, 'qCountDiagAll.mat'), "qCountDiagAll")
    save(fullfile(fileNameSaveCells, 'qCovAll.mat'), "qCovAll")
    save(fullfile(fileNameSaveCells, 'sigmaAll.mat'), "sigmaAll")
    save(fullfile(fileNameSaveCells, 'sigmaSquareAll.mat'), "sigmaSquareAll")
    save(fullfile(fileNameSaveCells, 'covAllMCPlus.mat'), "covAllMCPlus")
    save(fullfile(fileNameSaveCells, 'covAllMCMinus.mat'), "covAllMCMinus")
    save(fullfile(fileNameSaveCells, 'errAll.mat'), "errAll")
    save(fullfile(fileNameSaveCells, 'sampResMinusCovAll.mat'), "meas_sampCov_minus_avg")
    save(fullfile(fileNameSaveCells, 'sampResPlusCovAll.mat'), "meas_sampCov_plus_avg")
    save(fullfile(fileNameSaveCells, 'PyyAllMCMinus.mat'), "PyyAllMCMinus")
else
    load(fullfile(fileNameSaveCells, 'xErr.mat')); % , "xErrAll")
    load(fullfile(fileNameSaveCells, 'covAll.mat')); % , "covAll")
    load(fullfile(fileNameSaveCells, 'measAll.mat')); % , "measAll")
    load(fullfile(fileNameSaveCells, 'resAll.mat')); % , "resAll")
    load(fullfile(fileNameSaveCells, 'resCovAll.mat')); % , "resCovAll")
    load(fullfile(fileNameSaveCells, 'qCountDiagErrAll.mat')); % , "qCountDiagErrAll")
    load(fullfile(fileNameSaveCells, 'qCountDiagAll.mat')); % , "qCountDiagAll")
    load(fullfile(fileNameSaveCells, 'qCovAll.mat')); % , "qCovAll")
    load(fullfile(fileNameSaveCells, 'covAllMCPlus.mat')); % , "covAllMCPlus")
    load(fullfile(fileNameSaveCells, 'covAllMCMinus.mat')); % , "covAllMCMinus")
    load(fullfile(fileNameSaveCells, 'errAll.mat')); %, "errAll")
    load(fullfile(fileNameSaveCells, 'sigmaAll.mat')); % , "sigmaAll")
    load(fullfile(fileNameSaveCells, 'sigmaSquareAll.mat')); % , "sigmaSquaredAll")
    load(fullfile(fileNameSaveCells, 'sampResMinusCovAll.mat'));%, "meas_sampCov_minus_avg")
    load(fullfile(fileNameSaveCells, 'sampResPlusCovAll.mat'));%, "meas_sampCov_plus_avg")
    load(fullfile(fileNameSaveCells, 'PyyAllMCMinus.mat'));%, "PyyAllMCMinus")
end

if time(1) ~= 0
    time = time - time(1);
end

if contains(flagScenario, 'nonDim')
    time = time*tCharacteristic;
end

if strcmp(timeUnit, '[h]')
    time = time / 3600; % Convert to Hours
elseif strcmp(timeUnit, '[min]')
    time = time / 60; % Convert to min
end

%% NEES Results
load(fullfile(fileBase, strcat(accelName, flagGravModelTruth, flagGravModel, burnName), 'NEEShist.mat'))
load(fullfile(fileBase, strcat(accelName, flagGravModelTruth, flagGravModel, burnName), 'NEESdiaghist.mat'))
epsNEESbar = mean(NEES,1);
epsNEESdiagbar = mean(NEESdiag,1);
alphaNEES = 0.01; % significance level
Nnx = nMC*n;
% Compute Intervals:
r1x = chi2inv(alphaNEES/2, Nnx )./ nMC;
r2x = chi2inv(1-alphaNEES/2, Nnx )./ nMC;
figNEES = figure(80);
ax = gca;
ax.GridLineWidth = gridLineWidth;
ax.LineWidth = axesLineWidth;
ax.FontSize = fontSize;
hold on
grid minor
box on
plot(epsNEESbar(2:end),'o','MarkerSize',markerSize, 'Color', magentaCB)
plot(epsNEESdiagbar(2:end),'o','MarkerSize',markerSize, 'Color', darkGreenCB)
plot(r1x*ones(size(epsNEESbar(2:end))),'k--', 'LineWidth', line_width)
plot(r2x*ones(size(epsNEESbar(2:end))),'k--', 'LineWidth', line_width)
ylabel('NEES statistic, $\bar{\epsilon}_x$', 'FontSize',fontSize, 'Interpreter','latex')
xlabel(strcat('Time ', timeUnit), 'FontSize',fontSize, 'Interpreter','latex')
title('NEES Estimation Results','FontSize',fontSize, 'Interpreter','latex')
legend('NEES @ time k', 'NEES @ time k diag','$r_1$ bound', '$r_2$ bound', 'location', 'Best', 'FontSize',fontSize, 'Interpreter','latex')
set(gcf, 'Position', figLoc)
