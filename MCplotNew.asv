function [RTN_N] = inertial2rtn(x_N)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Purpose: Produce DCM from inertial to RTN
%
% Assumptions:
%
% Inputs:
%   x_N         position and velocity of the true vehicle
%
% Output:
%   RTN_N       DCM that defines the rotation from the inertial frame to
%                   the radial, tranverse, normal frame
%
% Author: Rachel Mamich
% Creater: 10/31/2023
% Modified: 10/31/2023
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
r = x_N(1:3);
v = x_N(4:6);
raxis = r;
raxis = raxis/norm(raxis);

naxis = cross(r, v);
naxis = naxis/norm(naxis);


taxis = cross(naxis, raxis);
taxis = taxis/norm(taxis);

RTN_N = [raxis, taxis, naxis]';

end