            % end
            % for iiMC = plotList
            diagPyyMinus = resCovAll{firstPlot, 1};
            p5 = plot(time, 3*meas_sampCov_minus_avg(iiMeasPlot, :), ':', 'LineWidth', line_width,  'Color', darkGreenCB);
            plot(time, -3*meas_sampCov_minus_avg(iiMeasPlot, :), ':', 'LineWidth', line_width,  'Color', darkGreenCB);
            % p4 = plot(time, 3*diagPyyMinus(iiMeasPlot, :), '--k', 'LineWidth', line_width);
            % plot(time, -3*diagPyyMinus(iiMeasPlot, :), '--k', 'LineWidth', line_width)
            p4 = plot(time, 3*PyyAllMCMinus(iiMeasPlot, :), '--', 'LineWidth', line_width, 'Color', magentaCB);
            plot(time, -3*PyyAllMCMinus(iiMeasPlot, :), '--', 'LineWidth', line_width, 'Color', magentaCB);
            plotLabelLines = [p2, p4, p5];
            legend(plotLabelLines, 'ith Run Error$^-$', '$Avg 3\sigma^-$', 'Sample $3\sigma^-$','Interpreter','latex', 'location', 'BestOutside')
            % end
        end
        count1 = count1+1;
        if strcmp(flagZoomSave, 'zoomEnd')
            xlim([xlimSet(1), xlimSet(2)])
        elseif strcmp(flagZoomSave, 'zoomAll')
            xlim(xlimSet)
        end
