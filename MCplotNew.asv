            figNameCells{figCount} = fullfile(figNameSave, strcat(figNameMeas{iiMeasPlot}, '_res', figNameEnd));
            exportgraphics(gcf, figNameCells{figCount}, 'resolution',300)
            % saveas(fig(figCount), fullfile(figNameSave, strcat(figNameMeas{iiMeasPlot}, '_res', figNameEnd)))
        end
